{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-22",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "337500fb-2c58-442a-981a-576a541b4d31","database_name": "web-app-22" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "640d7f49019f4e0a91eab8b1b3d950e9" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
